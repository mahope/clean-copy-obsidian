{
  "manifest_version": 3,
  "name": "Clean Copy",
  "version": "1.0.0",
  "description": "Copy any text as clean, formatted Markdown. No more messy pastes — just right-click and copy.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "storage"
  ],
  "action": {
    "default_title": "Clean Copy",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "copy-as-markdown": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy selected text as clean Markdown"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_end"
  }],
  "host_permissions": [
    "<all_urls>"
  ]
}